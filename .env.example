# Frantics — environment variables
# Copy to .env for local dev (NEVER commit the real .env).

# HTTP + WebSocket port. Default 3000.
PORT=3000

# Log level: debug, info, warn, error. Default: info.
# debug emits every protocol-dropped message and client error; info is
# the production default.
LOG_LEVEL=info

# Set to 1 to log every rejected WebSocket protocol message (noisy; only
# useful when debugging a misbehaving client).
DEBUG_PROTOCOL=
