{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "types/**/*.d.ts",
    "client-shared/**/*.js",
    "server/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "client-shared/pretext.js",
    "client-shared/qrcode.min.js",
    "client-host-escape/lib/**",
    "**/*.test.js",
    // IIFE-pattern source files declare their window global as
    // `const Name = (() => {...})()`. The global's TYPE CONTRACT
    // lives in types/globals.d.ts; consumer sites type-check
    // against that contract. The internal implementations stay
    // out of tsc's include list to avoid const-redeclare conflict.
    "client-shared/sound.js",
    "client-shared/narrator.js",
    "client-shared/tournament.js",
    "client-shared/postgame.js",
    "client-shared/host-common.js",
    "client-shared/hud.js",
    "client-shared/visual.js",
    "client-shared/icons.js",
    "client-shared/transitions.js",
    "client-shared/effects.js",
    "client-shared/characters.js",
    "client-shared/colors.js",
    "client-shared/pretext-hooks.js",
    "client-shared/ambient-fx.js",
    "client-shared/protocol.js",
    "client-shared/host-harness.js",
    "client-shared/error-reporter.js",
    "**/*.test.js"
  ]
}
